{
  "name": "niticket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run db:generate && bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "worker": "bun --env-file=.env apps/worker/src/index.ts",
    "typecheck": "bun --bun tsc --noEmit && bun run --cwd apps/web typecheck",
    "lint": "bun --bun eslint .",
    "format": "bun --bun prettier --write . && bun --bun prisma format --schema packages/database/prisma/schema.prisma",
    "format:check": "bun --bun prettier --check .",
    "test": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration",
    "test:e2e": "bun --bun playwright test",
    "db:generate": "bun --bun prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "bun --bun prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "admin:bootstrap": "bun --env-file=.env scripts/bootstrap.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@fontsource/vazirmatn": "^5.2.0",
    "@hookform/resolvers": "^5.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "better-auth": "1.7.17",
    "bullmq": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-type": "^21.0.0",
    "ioredis": "^5.0.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "pdfjs-dist": "^6.5.438",
    "pino": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.0.0",
    "read-excel-file": "^9.3.14",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.0.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "esbuild",
    "sharp",
    "@tailwindcss/oxide"
  ]
}
