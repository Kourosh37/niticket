# Copy to .env. Replace every CHANGE_ME value before starting Compose..
POSTGRES_USER=niticket
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=niticket
DATABASE_URL=postgresql://niticket:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/niticket
REDIS_URL=redis://127.0.0.1:6379
BETTER_AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_PROVIDER=minio
S3_BUCKET=niticket-private
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_AT_LEAST_32_CHARS
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=niticket@localhost
SMTP_USER=
SMTP_PASSWORD=
LOG_LEVEL=info
MAX_UPLOAD_BYTES=10485760
MAX_VOICE_SECONDS=180
REOPEN_DAYS=7
BOOTSTRAP_ENABLED=false
