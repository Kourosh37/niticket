{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@niticket/core/*": ["./packages/core/src/*"],
      "@niticket/database": ["./packages/database/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/worker/**/*.ts", "scripts/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "apps/web/.next"]
}
